---
import Base from '../layouts/Base.astro';
import { hasResume } from '../data/site';
---
<Base title="About · Ploypairaoh Pat" description="Computational and Data Science student at George Mason University, focused on data analysis and business decisions. Expected graduation: 2027." active="about">
  <header class="ph"><div class="read"><span class="eyebrow">About</span><h1>Analysis is the last mile before a decision.</h1></div></header>
  <div class="tape"></div>
  <main class="read"><div class="ab">
    <div>
      <p>I'm Ploypairaoh Pat, studying for a <strong>B.S. in Computational and Data Science at George Mason University</strong>, with expected graduation in <strong>2027</strong>.</p>
      <p>My work focuses on <strong>data analysis that informs decisions</strong>: measuring portfolio risk, comparing fraud-review costs, and building tested SQL metrics. These projects combine Python, SQL, and machine learning with clear explanations of findings, assumptions, and limitations.</p>
      <p>Each case study connects a question to the data, method, and recommendation, so readers can assess what the evidence supports and what needs further evaluation.</p>
    </div>
    <aside class="side">
      <div class="ccard"><div class="ct">Explore my work</div>
        <a href="https://github.com/PloypairaohPat" target="_blank" rel="noopener">GitHub<span class="ar">↗</span></a>
        {hasResume && <a href="/resume.pdf">Résumé (PDF)<span class="ar">↓</span></a>}
      </div>
    </aside>
  </div></main>
</Base>
