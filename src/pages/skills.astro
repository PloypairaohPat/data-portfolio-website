---
import Base from '../layouts/Base.astro';
const LEVELS = { Proficient: [92, 'lv-adv'], 'Working knowledge': [68, 'lv-pro'], Familiar: [42, 'lv-fam'] };
const cats = [
  ['Languages & Querying', [['Python','Proficient','Risk · NLP · Fraud · Compliance · Monitoring'],['SQL','Proficient','Analytics engineering · Compliance'],['R','Familiar','Data analysis'],['dbt','Working knowledge','SQL warehouse · Compliance masking'],['TypeScript','Working knowledge','Ledger full-stack app']]],
  ['Machine Learning', [['scikit-learn','Working knowledge','Fraud · Fake-news NLP'],['XGBoost','Working knowledge','Fraud · Fake-news NLP'],['imbalanced-learn / SMOTE','Working knowledge','Fraud detection'],['SHAP','Working knowledge','Fraud explainability'],['spaCy / NLP','Working knowledge','Fake-news classifier']]],
  ['MLOps & Engineering', [['Evidently AI','Working knowledge','Model monitoring'],['MLflow','Working knowledge','Model monitoring'],['Apache Airflow','Familiar','Model monitoring DAG']]],
  ['Data & Analytics', [['pandas / NumPy','Proficient','Risk · NLP · Fraud · Compliance · Monitoring'],['DuckDB','Working knowledge','SQL warehouse · Compliance'],['Great Expectations','Working knowledge','Compliance audit']]],
  ['Domain & Full-Stack', [['Quantitative Risk — VaR, Monte Carlo','Working knowledge','Portfolio risk'],['GDPR / CCPA governance','Familiar','Compliance audit'],['Express','Working knowledge','Ledger finance app'],['Star-schema / dimensional modelling','Working knowledge','SQL warehouse']]],
  ['Visualization & Apps', [['matplotlib · seaborn','Working knowledge','Risk · Fraud · Inventory analysis'],['Plotly','Working knowledge','Risk · Fraud'],['Streamlit','Familiar','Fake-news classifier'],['React · Node.js','Working knowledge','Ledger finance app'],['PostgreSQL · Prisma','Working knowledge','Ledger finance app'],['Plaid API','Familiar','Ledger finance app']]],
  ['Workplace Tools', [['Microsoft Office (Excel, Word, PowerPoint)','Working knowledge','Inventory analysis · Reports · Presentations'],['Slack','Familiar','Team communication'],['SharePoint','Familiar','AV inventory committee'],['Power Apps','Familiar','AV inventory committee']]],
];
---
<Base title="Skills Matrix · Ploypairaoh Pat" description="Skills in languages, analytics, machine learning, visualization, apps, and workplace tools, grounded in projects and experience." active="skills">
  <header class="ph"><div class="read"><span class="eyebrow">Skills</span><h1>Skills matrix</h1><p class="dek">Skills grounded in project work, coursework, and workplace experience.</p></div></header>
  <div class="tape"></div>
  <main class="read">
    <div class="legend">
      {Object.entries(LEVELS).map(([lv, wc]) => (
        <div class="lg"><span class="bar"><i style={`width:${wc[0]}%`}></i></span><span class={'t ' + wc[1]}>{lv}</span></div>
      ))}
    </div>
    {cats.map((cat) => (
      <div class="cat"><h2>{cat[0]}</h2>
        {cat[1].map((row) => (
          <div class="smrow">
            <div class="smname">{row[0]}<span>{row[2]}</span></div>
            <div class="smbar"><i style={`width:${LEVELS[row[1]][0]}%`}></i></div>
            <div class={'smlevel ' + LEVELS[row[1]][1]}>{row[1]}</div>
          </div>
        ))}
      </div>
    ))}
  </main>
</Base>
