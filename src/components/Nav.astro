---
import { hasResume, resumePath } from '../data/site';
const { active } = Astro.props;
---
<nav class="nav" aria-label="Main navigation"><div class="wrap nav-inner">
  <a href="/" class="brand"><span class="dot"></span>PLOYPAIRAOH&nbsp;PAT</a>
  <div class="nlinks">
    <a href="/#work">Work</a>
    <a href="/skills" class={active === 'skills' ? 'on' : ''} aria-current={active === 'skills' ? 'page' : undefined}>Skills</a>
    <a href="/about" class={active === 'about' ? 'on' : ''} aria-current={active === 'about' ? 'page' : undefined}>About</a>
    {hasResume && <a href={resumePath} class="nav-resume">Resume</a>}
  </div>
</div></nav>
